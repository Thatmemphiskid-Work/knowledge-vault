# Normalize text in Git; let Windows checkouts use native line endings.
* text=auto
*.md text
*.py text
*.json text
*.csv text
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Source books and portable runtime binaries must remain byte-for-byte intact.
*.pdf binary
*.exe binary
*.dll binary
*.pyd binary
*.zip binary
